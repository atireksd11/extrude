EXTRUDE_MODEL_URL=https://openrouter.ai/api/v1/chat/completions
EXTRUDE_MODEL_KEY=your-openrouter-key

EXTRUDE_MODEL=openai/gpt-6-luna
EXTRUDE_GATE_NAME=luna
EXTRUDE_GATE_RUN=1
# Optional legacy circuit tools; set to your own installed executable.
# NGSPICE_PATH=C:\tools\ngspice\bin\ngspice_con.exe

# Optional when KiCad is not on PATH or in its standard install directory.
# KICAD_CLI_PATH=C:\Program Files\KiCad\10.0\bin\kicad-cli.exe

# Set automatically on Render; set explicitly on any other public deployment.
# Hosted data/API routes fail closed unless a strong shared token is configured.
EXTRUDE_HOSTED=0
# Required for HTTP redirects when hosted; use your canonical HTTPS origin.
# EXTRUDE_PUBLIC_ORIGIN=https://extrude.onrender.com
# Never expose trusted local mode to a network. Bind local uvicorn to 127.0.0.1.

# Optional bounds for a trusted local operator (always enforced in hosted mode).
EXTRUDE_RATE_LIMIT=0

# Interim shared access only, NOT user accounts or tenant isolation.
# Generate at least 32 random bytes out of band; paste only into environment settings.
# EXTRUDE_API_TOKEN=
# Token holders share repositories. Never put private or paid work here.
# Server-folder projects and legacy design/code-generation APIs stay disabled when hosted.
